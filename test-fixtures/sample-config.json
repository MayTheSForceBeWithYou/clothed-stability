{
  "source": {
    "organizationUrl": "https://dev.azure.com/my-source-org",
    "project": "SourceProject",
    "auth": {
      "type": "pat",
      "tokenEnvVar": "ADO_SOURCE_PAT"
    }
  },
  "target": {
    "organizationUrl": "https://dev.azure.com/my-target-org",
    "project": "TargetProject",
    "auth": {
      "type": "pat",
      "tokenEnvVar": "ADO_TARGET_PAT"
    }
  },
  "execution": {
    "dryRun": false,
    "logLevel": "info",
    "concurrency": 2
  }
}
