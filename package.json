{
  "name": "clothed-stability",
  "version": "0.0.1",
  "private": true,
  "description": "Azure DevOps migration tool monorepo",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "cli": "pnpm --filter cli start",
    "clean": "pnpm -r clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^25.5.2",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^9.21.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.58.1",
    "vitest": "^3.1.1"
  }
}
